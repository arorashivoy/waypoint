# --- required ---
DATABASE_URL="file:../data/waypoint.db"

# --- who you are (used for the local account) ---
WAYPOINT_NAME="Your Name"
WAYPOINT_EMAIL="you@example.com"

# --- remote access ---
# Required at sign-in whenever this is set. Set it before exposing the app
# beyond localhost. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(9).toString('base64url'))"
# WAYPOINT_ACCESS_CODE=

# --- Claude ---
# Default: Waypoint shells out to the `claude` CLI, which uses your Pro or Max
# subscription. Nothing to configure beyond having run `claude login` once.
# WAYPOINT_CLAUDE_MODE=cli          # cli (default) or api
# WAYPOINT_CLAUDE_BIN=claude        # if `claude` is not on PATH, put the full path here
# WAYPOINT_CLAUDE_TIMEOUT_MS=120000
#
# Long-lived Claude Code OAuth token, for headless hosts where you cannot keep
# an interactive `claude login` session alive. Generate one with:
#   claude setup-token
# The CLI picks this up automatically when it is present in the environment,
# so nothing else needs to change. Bills against your Pro or Max subscription.
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat-...
#
# Only if you want to bypass the subscription and pay API credit instead:
# ANTHROPIC_API_KEY=sk-ant-...

# --- optional: port ---
# Only for a second copy on the same machine (two users on one Pi). Read by
# `npm run dev`, `npm start` and scripts/remote.sh; a PORT set in the shell wins.
# PORT=3118

# --- optional job source ---
# Free tier at https://developer.adzuna.com
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# --- optional: real LinkedIn sign-in (OpenID Connect) ---
# Gives name, email and photo only. Everything else comes from the data export.
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_REDIRECT_URI=http://localhost:3117/api/auth/linkedin/callback

# --- optional: the CV that goes out with a referral ---
# The base CV. Sent as-is whenever tailoring is unavailable, and the feature is
# off entirely when neither this nor RESUME_TEX is set. `~` is expanded.
# RESUME_PDF="~/Programs/job-apply/tmp/Resume/ShivoyArora_Resume_2026.pdf"
#
# The LaTeX source behind it — the same document as RESUME_PDF, not a different
# CV, since the tailored build replaces the PDF above. Setting this turns on per-job tailoring: before a
# referral message is drafted, Waypoint scores every project and skill in claims.yml
# against that posting — by claim label, alias and one link hop — and picks what
# the CV carries: the best-fitting projects (including ones not on this CV that
# have a `tex:` entry in claims.yml), the lead role's bullets in order, and the
# evidenced skills the posting asks for. Then it recompiles. If a section cannot
# be mapped to claims.yml with confidence, or the compile fails, the base PDF
# above is served unchanged and the UI says why.
# RESUME_TEX="~/Programs/job-apply/tmp/Resume/ShivoyArora_Resume_2026.tex"
#
# A URL a recruiter can actually open — Drive, a portfolio, anything public.
# The referral message only offers a link when this is set; without it the
# message keeps the older "happy to send my CV", because a localhost path in a
# LinkedIn message is worse than no link at all. The tailored PDF is still built
# for you to attach by hand.
# RESUME_PUBLIC_URL=
#
# LaTeX engine. Auto-detected in this order when unset: tectonic, pdflatex,
# xelatex, lualatex. Tectonic is preferred because it fetches its own packages.
# RESUME_ENGINE=
#
# How many projects the tailored CV carries, chosen from claims.yml. Unset keeps
# the base CV's count, so swapping a project in cannot change the page count.
# RESUME_MAX_PROJECTS=
#
# Where tailored PDFs are written, and how long a compile may take.
# RESUME_OUT_DIR=data/resumes
# RESUME_TIMEOUT_MS=180000
#
# --- optional: share the tailored CV from Google Drive ---
# With these set, each referral message carries a link to the CV built for that
# posting. One file per job, so a referrer opening the link weeks later still
# sees the version tailored for their company, and the link is saved against
# the application so you can see before an interview exactly what they read.
#
# Scope is drive.file: Waypoint can only touch files it created itself.
# Uploaded files are set to "anyone with the link" — that is what makes the link
# work in a message, and it does mean the PDF, with your phone number and email
# on it, is readable by anyone it is forwarded to. Revoke any of them from the
# file's sharing menu, or all of them at https://myaccount.google.com/permissions
#
# Get a client id and secret from console.cloud.google.com (Drive API enabled,
# OAuth client of type "Desktop app"), put them here, then run:
#   npm run gdrive:auth
# which prints the refresh token to paste back in.
# GDRIVE_CLIENT_ID=
# GDRIVE_CLIENT_SECRET=
# GDRIVE_REFRESH_TOKEN=
# GDRIVE_FOLDER_ID=            # optional: upload into this folder, not the root
