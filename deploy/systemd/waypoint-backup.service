# One backup run. The timer starts it. install-units.sh fills in the placeholders.
# The start limit stops a failed backup from retrying each 5 seconds for ever.
[Unit]
Description=Waypoint backup
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=oneshot
WorkingDirectory=@CHECKOUT@
EnvironmentFile=@CHECKOUT@/.env
Environment=PATH=@NODE_BIN@:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env npm run backup
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
