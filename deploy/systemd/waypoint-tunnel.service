# The public zrok share. install-units.sh fills in @CHECKOUT@ and @NODE_BIN@.
# tunnel.sh reads the port with scripts/port.mjs, so it needs node on PATH.
[Unit]
Description=Waypoint zrok tunnel
After=network-online.target waypoint-web.service
Wants=network-online.target waypoint-web.service

[Service]
Type=simple
WorkingDirectory=@CHECKOUT@
EnvironmentFile=@CHECKOUT@/.env
Environment=PATH=@NODE_BIN@:/usr/local/bin:/usr/bin:/bin
ExecStart=@CHECKOUT@/scripts/tunnel.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
