{
  "name": "waypoint",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p $(node scripts/port.mjs)",
    "build": "prisma generate && next build",
    "start": "next start -p $(node scripts/port.mjs)",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup": "prisma generate && prisma db push && tsx prisma/seed.ts",
    "check:claims": "tsx scripts/check-claims.ts",
    "gdrive:auth": "tsx --env-file=.env scripts/gdrive-auth.ts",
    "secret:new": "node scripts/new-secret.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "WAYPOINT_LIVE=1 vitest run tests/live",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@prisma/client": "^5.22.0",
    "adm-zip": "^0.5.16",
    "next": "^14.2.35",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.5",
    "@types/node": "22.20.5",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "5.0.5"
  }
}
